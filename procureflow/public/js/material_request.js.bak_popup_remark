            // 🔥 Avoid duplicate button
            if (!grid.custom_button_added) {

                let btn = $(`
                    <div style="margin-bottom:10px;">
                        <button class="btn btn-sm"
                            style="
                                background-color:#000;
                                color:#fff;
                                border-radius:4px;
                                padding:5px 12px;
                            ">
                            Add Item
                        </button>
                    </div>
                `);

                // btn.find('button').on('click', function () {
                //     open_item_popup(frm);
                // });

                btn.find('button').on('click', function () {

