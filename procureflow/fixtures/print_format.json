  "html": "<style>\r\n\r\n@page {\r\n    size: A4;\r\n    margin: 15mm;\r\n}\r\n\r\nbody {\r\n    font-family: Arial, sans-serif;\r\n    font-size: 10px;\r\n    color: #000;\r\n}\r\n\r\n/* HEADER */\r\n.header {\r\n    text-align: center;\r\n    font-weight: bold;\r\n    font-size: 14px;\r\n}\r\n\r\n.sub-header {\r\n    text-align: center;\r\n    font-size: 15px;\r\n    /*font-weight:bold;*/\r\n    margin-bottom: 10px;\r\n}\r\n\r\n/* LINE */\r\n.line {\r\n    border-top: 1px solid #000;\r\n    margin: 10px 0;\r\n}\r\n\r\n/* TABLE TOP */\r\n.top-table {\r\n    width: 100%;\r\n}\r\n\r\n.top-table td {\r\n    vertical-align: top;\r\n    padding: 3px;\r\n}\r\n\r\n/* ITEMS TABLE */\r\n.items {\r\n    width: 100%;\r\n    border-collapse: collapse;\r\n    margin-top: 10px;\r\n}\r\n\r\n.items th, .items td {\r\n    border: 1px solid #000;\r\n    padding: 5px;\r\n    font-size: 10px;\r\n}\r\n\r\n.items th {\r\n    text-align: center;\r\n    font-weight: bold;\r\n}\r\n\r\n/* ALIGN */\r\n.items td:nth-child(1) { text-align: center; }\r\n.items td:nth-child(3),\r\n.items td:nth-child(4),\r\n.items td:nth-child(6) { text-align: center; }\r\n\r\n.items td:nth-child(5),\r\n.items td:nth-child(7) { text-align: right; }\r\n\r\n/* SIGN */\r\n.sign {\r\n    text-align: right;\r\n    margin-top: 40px;\r\n    font-weight: bold;\r\n}\r\n\r\n/* TERMS */\r\n.terms {\r\n    margin-top: 15px;\r\n    font-size: 10px;\r\n}\r\n\r\n</style>\r\n\r\n<div class=\"header\">PURCHASE ORDER</div>\r\n<div class=\"sub-header\">{{ doc.company }}</div>\r\n\r\n<div class=\"line\"></div>\r\n\r\n<table class=\"top-table\">\r\n<tr>\r\n\r\n<td width=\"60%\">\r\nSupplier: <b>{{ doc.supplier }}</b><br>\r\nAddress: {{ doc.address_display or \"\" }}\r\n</td>\r\n\r\n<td width=\"40%\">\r\nFin Year: {{ frappe.utils.formatdate(doc.transaction_date,\"yyyy\") }}<br>\r\nPO No: {{ doc.name }}<br>\r\nPO Date: {{ frappe.utils.formatdate(doc.transaction_date,\"dd-MM-yyyy\") }}<br>\r\nLocation: {{ doc.cost_center or \"\" }}<br>\r\nCost Centre: {{ doc.cost_center or \"\" }}\r\n</td>\r\n\r\n</tr>\r\n</table>\r\n\r\n<br>\r\n\r\n<b>Subject :</b>\r\n\r\n{% if doc.custom_direct_po == 1 %}\r\nDirect Purchase Order : {{ doc.custom_po_remark_ or \"\" }}\r\n{% else %}\r\nPurchase Order Against Indent : {{ doc.custom_material_request_id or \"\" }}\r\n{% endif %}\r\n\r\n<br><br>\r\n\r\nWith reference to your quotation No. {{ doc.custom_quotation_number or \"\" }}\r\n\r\n<br>\r\nWe are pleased to place order for following:\r\n\r\n<!-- ITEMS TABLE -->\r\n\r\n<table class=\"items\">\r\n\r\n<tr>\r\n<th width=\"5%\">Sl No</th>\r\n<th width=\"45%\">Description</th>\r\n<th width=\"10%\">Due</th>\r\n<th width=\"10%\">Qty</th>\r\n<th width=\"10%\">Rate</th>\r\n<th width=\"5%\">Per</th>\r\n<th width=\"15%\">Amount</th>\r\n</tr>\r\n\r\n{% for item in doc.items %}\r\n<tr>\r\n\r\n<td>{{ loop.index }}</td>\r\n\r\n<td>\r\n<b>{{ item.item_code }}</b><br>\r\n{{ item.item_group or \"\" }}<br>\r\nSpecification: {{ item.custom_specification or \"\" }}\r\n</td>\r\n\r\n<td>\r\n{{ frappe.utils.formatdate(item.schedule_date,\"dd-MM-yyyy\") if item.schedule_date else \"\" }}\r\n</td>\r\n\r\n<td>\r\n<b>{{ item.qty }}</b> {{ item.uom }}\r\n</td>\r\n\r\n<td>\r\n{{ frappe.utils.fmt_money(item.rate, currency=doc.currency) }}\r\n</td>\r\n\r\n<td>\r\n{{ item.uom }}\r\n</td>\r\n\r\n<td>\r\n<b>{{ frappe.utils.fmt_money(item.amount, currency=doc.currency) }}</b>\r\n</td>\r\n\r\n</tr>\r\n{% endfor %}\r\n\r\n<tr>\r\n<td colspan=\"5\">\r\nIn Words: {{ doc.in_words }}\r\n</td>\r\n\r\n<td colspan=\"2\" align=\"right\">\r\nGross Total: {{ frappe.utils.fmt_money(doc.grand_total, currency=doc.currency) }}\r\n</td>\r\n</tr>\r\n\r\n</table>\r\n\r\n<!-- SIGN -->\r\n<!--<div class=\"sign\">-->\r\n<!--For {{ doc.company }}<br><br><br>-->\r\n<!--Authorised Signatory-->\r\n<!--</div>-->\r\n\r\n<!-- TERMS -->\r\n<div class=\"terms\">\r\n<b>Terms & Conditions</b><br>\r\n{{ doc.terms or \"\" }}<br><br>\r\nAll qualitative, quantitative discrepancy and wrong deliveries to your account.<br>\r\nPlease quote purchase order no in your invoice for smooth release of payment.\r\n</div>",
