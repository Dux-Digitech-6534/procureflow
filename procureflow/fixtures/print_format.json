  "doctype": "Print Format",
  "font": null,
  "font_size": 14,
  "format_data": null,
  "html": "<style>\r\n/* =========================================================\r\n   PROFESSIONAL PURCHASE ORDER PRINT FORMAT\r\n   ERPNext / Frappe Compatible | A4 Print Optimized\r\n   ========================================================= */\r\n\r\n@page {\r\n    size: A4;\r\n    margin: 8mm 10mm 8mm 10mm;\r\n}\r\n\r\nhtml,\r\nbody,\r\n.print-format {\r\n    margin: 0 !important;\r\n    padding: 0 !important;\r\n    background: #ffffff !important;\r\n    color: #111111;\r\n    font-family: Arial, Helvetica, sans-serif;\r\n    font-size: 10px;\r\n    line-height: 1.35;\r\n}\r\n\r\n.print-format {\r\n    width: 100%;\r\n}\r\n\r\n.print-format * {\r\n    box-sizing: border-box;\r\n}\r\n\r\n.po-document {\r\n    width: 100%;\r\n    color: #111111;\r\n    border: 1px solid #111111;\r\n    padding: 10px 12px 14px 12px;\r\n}\r\n\r\n/* =========================================================\r\n   COMMON\r\n   ========================================================= */\r\n\r\n.po-text-right {\r\n    text-align: right;\r\n}\r\n\r\n.po-text-center {\r\n    text-align: center;\r\n}\r\n\r\n.po-nowrap {\r\n    white-space: nowrap;\r\n}\r\n\r\n.po-wrap {\r\n    white-space: normal;\r\n    overflow-wrap: anywhere;\r\n    word-break: normal;\r\n}\r\n\r\n.po-strong {\r\n    font-weight: 700;\r\n}\r\n\r\n.po-avoid-break {\r\n    page-break-inside: avoid;\r\n    break-inside: avoid;\r\n}\r\n\r\n.po-section-title {\r\n    font-size: 10px;\r\n    font-weight: 700;\r\n    text-transform: uppercase;\r\n    color: #111111;\r\n    margin-bottom: 10px;\r\n}\r\n\r\n/* =========================================================\r\n   HEADER\r\n   ========================================================= */\r\n\r\n.po-header {\r\n    width: 100%;\r\n    border-collapse: collapse;\r\n    margin-bottom: 7px;\r\n}\r\n\r\n.po-header td {\r\n    padding: 0;\r\n    vertical-align: middle;\r\n}\r\n\r\n.po-logo-cell {\r\n    width: 86px;\r\n    text-align: left;\r\n}\r\n\r\n.po-logo {\r\n    display: block;\r\n    max-width: 78px;\r\n    max-height: 58px;\r\n    object-fit: contain;\r\n}\r\n\r\n.po-company-cell {\r\n    text-align: center;\r\n    padding: 0 10px !important;\r\n}\r\n\r\n.po-company-name {\r\n    font-size: 21px;\r\n    font-weight: 700;\r\n    line-height: 1.2;\r\n    letter-spacing: 0.3px;\r\n    text-transform: uppercase;\r\n    color: #111111;\r\n}\r\n\r\n.po-company-address {\r\n    margin-top: 5px;\r\n    font-size: 11px;\r\n    line-height: 1.3;\r\n    color: #222222;\r\n}\r\n\r\n.po-company-address p,\r\n.po-company-address div {\r\n    display: inline;\r\n    margin: 0;\r\n    padding: 0;\r\n}\r\n\r\n.po-header-spacer {\r\n    width: 86px;\r\n}\r\n\r\n.po-header-line {\r\n    border-top: 2px solid #111111;\r\n    margin: 9px 0 12px 0;\r\n}\r\n\r\n.po-document-title {\r\n    text-align: center;\r\n    font-size: 18px;\r\n    font-weight: 700;\r\n    letter-spacing: 0.5px;\r\n    text-transform: uppercase;\r\n    margin: 0 0 12px 0;\r\n}\r\n\r\n/* =========================================================\r\n   ADDRESS BOXES\r\n   ========================================================= */\r\n\r\n.po-address-table {\r\n    width: 100%;\r\n    border-collapse: separate;\r\n    border-spacing: 0;\r\n    table-layout: fixed;\r\n    margin-bottom: 12px;\r\n}\r\n\r\n.po-address-table td {\r\n    width: 50%;\r\n    vertical-align: top;\r\n    padding: 0;\r\n}\r\n\r\n.po-address-left {\r\n    padding-right: 6px !important;\r\n}\r\n\r\n.po-address-right {\r\n    padding-left: 6px !important;\r\n}\r\n\r\n.po-address-card {\r\n    width: 100%;\r\n    min-height: 210px;\r\n    height: 210px;\r\n    border: 1px solid #555555;\r\n    padding: 11px 12px;\r\n    overflow: hidden;\r\n}\r\n\r\n.po-party-name {\r\n    font-size: 11px;\r\n    font-weight: 700;\r\n    margin-bottom: 6px;\r\n    color: #111111;\r\n}\r\n\r\n.po-address {\r\n    font-size: 10.5px;\r\n    line-height: 1.42;\r\n    color: #111111;\r\n}\r\n\r\n.po-address p,\r\n.po-address div {\r\n    margin: 0;\r\n    padding: 0;\r\n}\r\n\r\n.po-contact {\r\n    margin-top: 26px;\r\n    font-size: 10.5px;\r\n    line-height: 1.55;\r\n}\r\n\r\n.po-contact-row {\r\n    display: table;\r\n    width: 100%;\r\n}\r\n\r\n.po-contact-label {\r\n    display: table-cell;\r\n    width: 70px;\r\n    font-weight: 700;\r\n}\r\n\r\n.po-contact-value {\r\n    display: table-cell;\r\n}\r\n\r\n/* =========================================================\r\n   PURCHASE ORDER INFORMATION\r\n   ========================================================= */\r\n\r\n.po-info-section {\r\n    width: 100%;\r\n    margin-bottom: 12px;\r\n    page-break-inside: avoid;\r\n    break-inside: avoid;\r\n}\r\n\r\n.po-info-title {\r\n    border: 1px solid #555555;\r\n    border-bottom: 0;\r\n    padding: 8px 10px;\r\n    font-size: 10.5px;\r\n    font-weight: 700;\r\n    text-transform: uppercase;\r\n}\r\n\r\n.po-info-table {\r\n    width: 100%;\r\n    border-collapse: collapse;\r\n    table-layout: fixed;\r\n}\r\n\r\n.po-info-table td {\r\n    border: 1px solid #555555;\r\n    padding: 8px 10px;\r\n    font-size: 10px;\r\n    line-height: 1.35;\r\n    vertical-align: middle;\r\n}\r\n\r\n.po-info-label {\r\n    width: 24%;\r\n    font-weight: 700;\r\n}\r\n\r\n.po-info-value {\r\n    width: 26%;\r\n}\r\n\r\n/* =========================================================\r\n   ITEM TABLE\r\n   ========================================================= */\r\n\r\n.po-items-table {\r\n    width: 100%;\r\n    border-collapse: collapse;\r\n    table-layout: fixed;\r\n    margin-bottom: 12px;\r\n}\r\n\r\n.po-items-table col.po-col-sl {\r\n    width: 5%;\r\n}\r\n\r\n.po-items-table col.po-col-code {\r\n    width: 10%;\r\n}\r\n\r\n.po-items-table col.po-col-desc {\r\n    width: 22%;\r\n}\r\n\r\n.po-items-table col.po-col-uom {\r\n    width: 7%;\r\n}\r\n\r\n.po-items-table col.po-col-qty {\r\n    width: 9%;\r\n}\r\n\r\n.po-items-table col.po-col-rate {\r\n    width: 10%;\r\n}\r\n\r\n.po-items-table col.po-col-amount {\r\n    width: 12%;\r\n}\r\n\r\n.po-items-table col.po-col-gst {\r\n    width: 7%;\r\n}\r\n\r\n.po-items-table col.po-col-gst-amount {\r\n    width: 10%;\r\n}\r\n\r\n.po-items-table col.po-col-total {\r\n    width: 13%;\r\n}\r\n\r\n.po-items-table thead {\r\n    display: table-header-group;\r\n}\r\n\r\n.po-items-table tr {\r\n    page-break-inside: avoid;\r\n    break-inside: avoid;\r\n}\r\n\r\n.po-items-table th {\r\n    border: 1px solid #555555;\r\n    background: #eeeeee;\r\n    padding: 7px 4px;\r\n    font-size: 9px;\r\n    font-weight: 700;\r\n    color: #111111 !important;\r\n    text-align: center;\r\n    vertical-align: middle;\r\n    line-height: 1.25;\r\n}\r\n\r\n.po-items-table td {\r\n    border: 1px solid #555555;\r\n    padding: 7px 6px;\r\n    font-size: 9.4px;\r\n    color: #111111;\r\n    vertical-align: middle;\r\n    line-height: 1.32;\r\n}\r\n\r\n.po-item-title {\r\n    font-weight: 700;\r\n    font-size: 10px;\r\n    margin-bottom: 3px;\r\n}\r\n\r\n.po-item-description {\r\n    font-size: 9.2px;\r\n    color: #111111;\r\n}\r\n\r\n.po-item-description p,\r\n.po-item-description div {\r\n    margin: 0;\r\n    padding: 0;\r\n}\r\n\r\n/* =========================================================\r\n   AMOUNT WORDS + SUMMARY\r\n   ========================================================= */\r\n\r\n.po-bottom-summary-table {\r\n    width: 100%;\r\n    border-collapse: separate;\r\n    border-spacing: 0;\r\n    table-layout: fixed;\r\n    margin-bottom: 12px;\r\n}\r\n\r\n.po-bottom-summary-table td {\r\n    vertical-align: top;\r\n    padding: 0;\r\n}\r\n\r\n.po-words-cell {\r\n    width: 48%;\r\n    padding-right: 12px !important;\r\n}\r\n\r\n.po-summary-cell {\r\n    width: 52%;\r\n}\r\n\r\n.po-amount-words {\r\n    min-height: 98px;\r\n    border: 1px solid #555555;\r\n    padding: 12px;\r\n    font-size: 10.5px;\r\n    line-height: 1.45;\r\n}\r\n\r\n.po-amount-words-title {\r\n    font-weight: 700;\r\n    margin-bottom: 8px;\r\n}\r\n\r\n.po-summary-table {\r\n    width: 100%;\r\n    border-collapse: collapse;\r\n    table-layout: fixed;\r\n}\r\n\r\n.po-summary-table td {\r\n    border: 1px solid #555555;\r\n    padding: 8px 10px;\r\n    font-size: 10.2px;\r\n    vertical-align: middle;\r\n}\r\n\r\n.po-summary-label {\r\n    width: 56%;\r\n    font-weight: 700;\r\n}\r\n\r\n.po-summary-value {\r\n    width: 44%;\r\n    text-align: right;\r\n}\r\n\r\n.po-summary-final td {\r\n    background: #eeeeee;\r\n    font-size: 12px;\r\n    font-weight: 700;\r\n}\r\n\r\n/* =========================================================\r\n   TERMS\r\n   ========================================================= */\r\n\r\n.po-terms-section {\r\n    width: 100%;\r\n    border: 1px solid #555555;\r\n    padding: 10px 12px;\r\n    margin-bottom: 22px;\r\n    font-size: 10px;\r\n    line-height: 1.45;\r\n    page-break-inside: avoid;\r\n    break-inside: avoid;\r\n}\r\n\r\n.po-terms-title {\r\n    font-size: 10.5px;\r\n    font-weight: 700;\r\n    margin-bottom: 7px;\r\n}\r\n\r\n.po-terms-content p,\r\n.po-terms-content div {\r\n    margin: 0 0 3px 0;\r\n    padding: 0;\r\n}\r\n\r\n.po-terms-content ul,\r\n.po-terms-content ol {\r\n    margin: 3px 0 0 16px;\r\n    padding: 0;\r\n}\r\n\r\n.po-terms-content li {\r\n    margin-bottom: 2px;\r\n}\r\n\r\n/* =========================================================\r\n   SIGNATURE\r\n   ========================================================= */\r\n\r\n.po-signature-section {\r\n    width: 100%;\r\n    margin-top: 16px;\r\n    text-align: right;\r\n    page-break-inside: avoid;\r\n    break-inside: avoid;\r\n}\r\n\r\n.po-signature-space {\r\n    height: 30px;\r\n}\r\n\r\n.po-sign-line {\r\n    display: inline-block;\r\n    width: 210px;\r\n    border-top: 1px solid #111111;\r\n    padding-top: 6px;\r\n    font-size: 10px;\r\n    font-weight: 700;\r\n    text-align: center;\r\n}\r\n\r\n/* =========================================================\r\n   PRINT OPTIMIZATION\r\n   ========================================================= */\r\n\r\n@media print {\r\n    html,\r\n    body,\r\n    .print-format {\r\n        -webkit-print-color-adjust: exact;\r\n        print-color-adjust: exact;\r\n    }\r\n\r\n    .po-items-table th,\r\n    .po-summary-final td {\r\n        -webkit-print-color-adjust: exact;\r\n        print-color-adjust: exact;\r\n    }\r\n\r\n    a {\r\n        color: #111111 !important;\r\n        text-decoration: none !important;\r\n    }\r\n}\r\n</style>\r\n\r\n{% set company = frappe.get_doc(\"Company\", doc.company) if doc.company else None %}\r\n{% set company_name = company.company_name if company else doc.company %}\r\n{% set currency = doc.currency or (company.default_currency if company else \"\") %}\r\n{% set company_logo = company.get(\"company_logo\") if company else \"\" %}\r\n\r\n{% set supplier = frappe.get_doc(\"Supplier\", doc.supplier) if doc.get(\"supplier\") else None %}\r\n\r\n{% set supplier_gstin = doc.get(\"gstin\") or doc.get(\"supplier_gstin\") or (supplier.get(\"gstin\") if supplier else \"\") %}\r\n{% set supplier_pan = (supplier.get(\"pan\") if supplier else \"\") or (supplier.get(\"pan_number\") if supplier else \"\") or doc.get(\"pan\") or doc.get(\"supplier_pan\") or doc.get(\"custom_pan\") or doc.get(\"custom_pan_number\") %}\r\n\r\n{% set company_address_doc = None %}\r\n{% if doc.get(\"company_address\") %}\r\n    {% set company_address_doc = frappe.get_doc(\"Address\", doc.get(\"company_address\")) %}\r\n{% elif company and company.get(\"company_address\") %}\r\n    {% set company_address_doc = frappe.get_doc(\"Address\", company.company_address) %}\r\n{% endif %}\r\n\r\n{% set supplier_address_doc = None %}\r\n{% if doc.get(\"supplier_address\") and not doc.get(\"address_display\") %}\r\n    {% set supplier_address_doc = frappe.get_doc(\"Address\", doc.supplier_address) %}\r\n{% endif %}\r\n\r\n{% set shipping_address_doc = None %}\r\n{% if doc.get(\"shipping_address\") and not doc.get(\"shipping_address_display\") %}\r\n    {% set shipping_address_doc = frappe.get_doc(\"Address\", doc.shipping_address) %}\r\n{% endif %}\r\n\r\n{% macro po_money(value) -%}\r\n    {{ frappe.utils.fmt_money(value or 0, currency=currency) }}\r\n{%- endmacro %}\r\n\r\n{% macro po_date(value) -%}\r\n    {{ frappe.utils.formatdate(value, \"dd-MM-yyyy\") if value else \"\" }}\r\n{%- endmacro %}\r\n\r\n{% set data = namespace(\r\n    project_name=\"\",\r\n    warehouse=doc.get(\"set_warehouse\") or doc.get(\"warehouse\") or doc.get(\"custom_warehouse\") or \"\",\r\n    total_item_gst=0\r\n) %}\r\n\r\n{% if doc.get(\"project\") %}\r\n    {% set data.project_name = frappe.db.get_value(\"Project\", doc.project, \"project_name\") or doc.project %}\r\n{% endif %}\r\n\r\n{% if doc.get(\"project_name\") or doc.get(\"custom_project_name\") %}\r\n    {% set data.project_name = doc.get(\"project_name\") or doc.get(\"custom_project_name\") %}\r\n{% endif %}\r\n\r\n{% for item in doc.items %}\r\n    {% if not data.warehouse and (item.get(\"warehouse\") or item.get(\"accepted_warehouse\")) %}\r\n        {% set data.warehouse = item.get(\"warehouse\") or item.get(\"accepted_warehouse\") %}\r\n    {% endif %}\r\n\r\n    {% if not data.project_name and item.get(\"project\") %}\r\n        {% set data.project_name = frappe.db.get_value(\"Project\", item.get(\"project\"), \"project_name\") or item.get(\"project\") %}\r\n    {% endif %}\r\n{% endfor %}\r\n\r\n{% set before_tax_total = doc.get(\"net_total\") or doc.get(\"total\") or 0 %}\r\n{% set total_taxes = doc.get(\"total_taxes_and_charges\") or 0 %}\r\n{% set grand_total = doc.get(\"grand_total\") or doc.get(\"rounded_total\") or (before_tax_total + total_taxes) %}\r\n\r\n{% set terms_data = namespace(content=doc.get(\"terms\") or \"\") %}\r\n{% if not terms_data.content and doc.get(\"tc_name\") %}\r\n    {% set terms_data.content = frappe.db.get_value(\"Terms and Conditions\", doc.get(\"tc_name\"), \"terms\") or \"\" %}\r\n{% endif %}\r\n{% if not terms_data.content %}\r\n    {% set terms_data.content = \"\r\n        <ol>\r\n            <li>Please supply the materials as per the specifications, quality and quantity mentioned above.</li>\r\n            <li>Delivery must be completed on or before the required by date.</li>\r\n            <li>All invoices must be raised in the name of the company.</li>\r\n            <li>Payment will be made as per the agreed payment terms.</li>\r\n            <li>Goods once supplied will not be taken back.</li>\r\n        </ol>\r\n    \" %}\r\n{% endif %}\r\n\r\n<div class=\"po-document\">\r\n\r\n    <!-- ===================== HEADER ===================== -->\r\n    <table class=\"po-header\">\r\n        <tr>\r\n            <td class=\"po-logo-cell\">\r\n                {% if company_logo %}\r\n                    <img src=\"{{ frappe.utils.get_url(company_logo) }}\" class=\"po-logo\">\r\n                {% endif %}\r\n            </td>\r\n\r\n            <td class=\"po-company-cell\">\r\n                <div class=\"po-company-name\">\r\n                    {{ company_name }}\r\n                </div>\r\n\r\n                <div class=\"po-company-address\">\r\n                    {% if company_address_doc %}\r\n                        {% if company_address_doc.address_line1 %}{{ company_address_doc.address_line1 }}{% endif %}\r\n                        {% if company_address_doc.address_line2 %}, {{ company_address_doc.address_line2 }}{% endif %}\r\n                        {% if company_address_doc.city %}, {{ company_address_doc.city }}{% endif %}\r\n                        {% if company_address_doc.state %}, {{ company_address_doc.state }}{% endif %}\r\n                        {% if company_address_doc.pincode %}, {{ company_address_doc.pincode }}{% endif %}\r\n                        {% if company_address_doc.country %}, {{ company_address_doc.country }}{% endif %}\r\n                    {% elif doc.get(\"company_address_display\") %}\r\n                        {{ doc.get(\"company_address_display\") | replace(\"<br>\", \", \") | replace(\"<br/>\", \", \") | replace(\"<br />\", \", \") | striptags }}\r\n                    {% elif doc.get(\"billing_address_display\") %}\r\n                        {{ doc.get(\"billing_address_display\") | replace(\"<br>\", \", \") | replace(\"<br/>\", \", \") | replace(\"<br />\", \", \") | striptags }}\r\n                    {% endif %}\r\n                </div>\r\n            </td>\r\n\r\n            <td class=\"po-header-spacer\"></td>\r\n        </tr>\r\n    </table>\r\n\r\n    <div class=\"po-header-line\"></div>\r\n\r\n    <div class=\"po-document-title\">\r\n        PURCHASE ORDER\r\n    </div>\r\n\r\n    <!-- ===================== SUPPLIER AND SHIPPING ADDRESS ===================== -->\r\n    <table class=\"po-address-table po-avoid-break\">\r\n        <tr>\r\n            <td class=\"po-address-left\">\r\n                <div class=\"po-address-card\">\r\n                    <div class=\"po-section-title\">Supplier (Vendor) Address</div>\r\n\r\n                    <div class=\"po-party-name\">\r\n                        {{ doc.get(\"supplier_name\") or doc.get(\"supplier\") }}\r\n                    </div>\r\n\r\n                    <div class=\"po-address\">\r\n                        {% if doc.get(\"address_display\") %}\r\n                            {{ doc.get(\"address_display\") | safe }}\r\n                        {% elif doc.get(\"supplier_address_display\") %}\r\n                            {{ doc.get(\"supplier_address_display\") | safe }}\r\n                        {% elif supplier_address_doc %}\r\n                            {% if supplier_address_doc.address_line1 %}{{ supplier_address_doc.address_line1 }}{% endif %}\r\n                            {% if supplier_address_doc.address_line2 %}<br>{{ supplier_address_doc.address_line2 }}{% endif %}\r\n                            {% if supplier_address_doc.city %}<br>{{ supplier_address_doc.city }}{% endif %}\r\n                            {% if supplier_address_doc.state %}<br>{{ supplier_address_doc.state }}{% endif %}\r\n                            {% if supplier_address_doc.pincode %}<br>{{ supplier_address_doc.pincode }}{% endif %}\r\n                            {% if supplier_address_doc.country %}<br>{{ supplier_address_doc.country }}{% endif %}\r\n                        {% endif %}\r\n                    </div>\r\n\r\n                    <div class=\"po-contact\">\r\n                        {% if doc.get(\"contact_mobile\") or doc.get(\"contact_phone\") %}\r\n                            <div class=\"po-contact-row\">\r\n                                <span class=\"po-contact-label\">Phone:</span>\r\n                                <span class=\"po-contact-value\">{{ doc.get(\"contact_mobile\") or doc.get(\"contact_phone\") }}</span>\r\n                            </div>\r\n                        {% endif %}\r\n\r\n                        {% if doc.get(\"contact_fax\") %}\r\n                            <div class=\"po-contact-row\">\r\n                                <span class=\"po-contact-label\">Fax:</span>\r\n                                <span class=\"po-contact-value\">{{ doc.get(\"contact_fax\") }}</span>\r\n                            </div>\r\n                        {% endif %}\r\n\r\n                        {% if doc.get(\"contact_email\") %}\r\n                            <div class=\"po-contact-row\">\r\n                                <span class=\"po-contact-label\">Email:</span>\r\n                                <span class=\"po-contact-value\">{{ doc.get(\"contact_email\") }}</span>\r\n                            </div>\r\n                        {% endif %}\r\n                    </div>\r\n                </div>\r\n            </td>\r\n\r\n            <td class=\"po-address-right\">\r\n                <div class=\"po-address-card\">\r\n                    <div class=\"po-section-title\">Shipping Address</div>\r\n\r\n                    <div class=\"po-address\">\r\n                        {% if doc.get(\"shipping_address_display\") %}\r\n                            {{ doc.get(\"shipping_address_display\") | safe }}\r\n                        {% elif shipping_address_doc %}\r\n                            {% if shipping_address_doc.address_line1 %}{{ shipping_address_doc.address_line1 }}{% endif %}\r\n                            {% if shipping_address_doc.address_line2 %}<br>{{ shipping_address_doc.address_line2 }}{% endif %}\r\n                            {% if shipping_address_doc.city %}<br>{{ shipping_address_doc.city }}{% endif %}\r\n                            {% if shipping_address_doc.state %}<br>{{ shipping_address_doc.state }}{% endif %}\r\n                            {% if shipping_address_doc.pincode %}<br>{{ shipping_address_doc.pincode }}{% endif %}\r\n                            {% if shipping_address_doc.country %}<br>{{ shipping_address_doc.country }}{% endif %}\r\n                        {% elif doc.get(\"shipping_address\") %}\r\n                            {{ doc.get(\"shipping_address\") | replace(\"\\n\", \"<br>\") | safe }}\r\n                        {% endif %}\r\n                    </div>\r\n\r\n                    <div class=\"po-contact\">\r\n                        {% if doc.get(\"shipping_contact_mobile\") %}\r\n                            <div class=\"po-contact-row\">\r\n                                <span class=\"po-contact-label\">Phone:</span>\r\n                                <span class=\"po-contact-value\">{{ doc.get(\"shipping_contact_mobile\") }}</span>\r\n                            </div>\r\n                        {% endif %}\r\n\r\n                        {% if doc.get(\"shipping_contact_fax\") %}\r\n                            <div class=\"po-contact-row\">\r\n                                <span class=\"po-contact-label\">Fax:</span>\r\n                                <span class=\"po-contact-value\">{{ doc.get(\"shipping_contact_fax\") }}</span>\r\n                            </div>\r\n                        {% endif %}\r\n\r\n                        {% if doc.get(\"shipping_contact_email\") %}\r\n                            <div class=\"po-contact-row\">\r\n                                <span class=\"po-contact-label\">Email:</span>\r\n                                <span class=\"po-contact-value\">{{ doc.get(\"shipping_contact_email\") }}</span>\r\n                            </div>\r\n                        {% endif %}\r\n                    </div>\r\n                </div>\r\n            </td>\r\n        </tr>\r\n    </table>\r\n\r\n    <!-- ===================== PURCHASE ORDER INFORMATION ===================== -->\r\n    <div class=\"po-info-section\">\r\n        <div class=\"po-info-title\">\r\n            Purchase Order Information\r\n        </div>\r\n\r\n        <table class=\"po-info-table\">\r\n            <tr>\r\n                <td class=\"po-info-label\">Purchase Order No.</td>\r\n                <td class=\"po-info-value\">{{ doc.name }}</td>\r\n                <td class=\"po-info-label\">Order Date</td>\r\n                <td class=\"po-info-value\">{{ po_date(doc.get(\"transaction_date\") or doc.get(\"posting_date\")) }}</td>\r\n            </tr>\r\n\r\n            <tr>\r\n                <td class=\"po-info-label\">GST Number</td>\r\n                <td class=\"po-info-value\">{{ supplier_gstin or \"\" }}</td>\r\n                <td class=\"po-info-label\">PAN Number</td>\r\n                <td class=\"po-info-value\">{{ supplier_pan or \"\" }}</td>\r\n            </tr>\r\n\r\n            <tr>\r\n                <td class=\"po-info-label\">Site / Project</td>\r\n                <td class=\"po-info-value\">\r\n                    {% if data.project_name %}{{ data.project_name }}{% endif %}\r\n                </td>\r\n                <td class=\"po-info-label\">Warehouse</td>\r\n                <td class=\"po-info-value\">\r\n                    {% if data.warehouse %}{{ data.warehouse }}{% endif %}\r\n                </td>\r\n            </tr>\r\n\r\n            <tr>\r\n                <td class=\"po-info-label\">Site Supervisor Name</td>\r\n                <td class=\"po-info-value\">{{ doc.get(\"custom_supervisor_name\") or \"\" }}</td>\r\n                <td class=\"po-info-label\">Site Supervisor Number</td>\r\n                <td class=\"po-info-value\">{{ doc.get(\"custom_supervisor_mobile\") or \"\" }}</td>\r\n            </tr>\r\n        </table>\r\n    </div>\r\n\r\n    <!-- ===================== ITEM TABLE ===================== -->\r\n    <table class=\"po-items-table\">\r\n        <colgroup>\r\n            <col class=\"po-col-sl\">\r\n            <col class=\"po-col-code\">\r\n            <col class=\"po-col-desc\">\r\n            <col class=\"po-col-uom\">\r\n            <col class=\"po-col-qty\">\r\n            <col class=\"po-col-rate\">\r\n            <col class=\"po-col-amount\">\r\n            <col class=\"po-col-gst\">\r\n            <col class=\"po-col-gst-amount\">\r\n            <col class=\"po-col-total\">\r\n        </colgroup>\r\n\r\n        <thead>\r\n            <tr>\r\n                <th>Sr<br>No</th>\r\n                <th>Item</th>\r\n                <th>Item Description</th>\r\n                <th>Unit</th>\r\n                <th>Quantity</th>\r\n                <th>Rate<br>({{ currency }})</th>\r\n                <th>Amount<br>({{ currency }})</th>\r\n                <th>GST %</th>\r\n                <th>GST Amount<br>({{ currency }})</th>\r\n                <th>Total Amount<br>({{ currency }})</th>\r\n            </tr>\r\n        </thead>\r\n\r\n        <tbody>\r\n            {% for item in doc.items %}\r\n\r\n                {% set item_amount = item.get(\"amount\") or item.get(\"net_amount\") or 0 %}\r\n                {% set item_rate = item.get(\"rate\") or item.get(\"net_rate\") or 0 %}\r\n\r\n                {% set gst_percent_data = namespace(value=0) %}\r\n                {% set gst_amount_data = namespace(value=0) %}\r\n\r\n                {% if item.get(\"gst_rate\") %}\r\n                    {% set gst_percent_data.value = item.get(\"gst_rate\") %}\r\n                {% elif item.get(\"igst_rate\") or item.get(\"cgst_rate\") or item.get(\"sgst_rate\") %}\r\n                    {% set gst_percent_data.value = (item.get(\"igst_rate\") or 0) + (item.get(\"cgst_rate\") or 0) + (item.get(\"sgst_rate\") or 0) %}\r\n                {% endif %}\r\n\r\n                {% if item.get(\"tax_amount\") %}\r\n                    {% set gst_amount_data.value = item.get(\"tax_amount\") %}\r\n                {% elif item.get(\"gst_amount\") %}\r\n                    {% set gst_amount_data.value = item.get(\"gst_amount\") %}\r\n                {% elif item.get(\"igst_amount\") or item.get(\"cgst_amount\") or item.get(\"sgst_amount\") %}\r\n                    {% set gst_amount_data.value = (item.get(\"igst_amount\") or 0) + (item.get(\"cgst_amount\") or 0) + (item.get(\"sgst_amount\") or 0) %}\r\n                {% elif gst_percent_data.value %}\r\n                    {% set gst_amount_data.value = (item_amount * gst_percent_data.value) / 100 %}\r\n                {% endif %}\r\n\r\n                {% set row_total = item_amount + gst_amount_data.value %}\r\n                {% set data.total_item_gst = data.total_item_gst + gst_amount_data.value %}\r\n\r\n                <tr>\r\n                    <td class=\"po-text-center po-nowrap\">\r\n                        {{ loop.index }}\r\n                    </td>\r\n\r\n                    <td class=\"po-text-center po-wrap\">\r\n                        {{ item.get(\"item_code\") or \"\" }}\r\n                    </td>\r\n\r\n                    <td class=\"po-wrap\">\r\n                        <div class=\"po-item-title\">\r\n                            {{ item.get(\"item_name\") or item.get(\"item_code\") }}\r\n                        </div>\r\n\r\n                        {% if item.get(\"description\") and item.get(\"description\") != item.get(\"item_name\") %}\r\n                            <div class=\"po-item-description\">\r\n                                {{ item.get(\"description\") | safe }}\r\n                            </div>\r\n                        {% endif %}\r\n                    </td>\r\n\r\n                    <td class=\"po-text-center po-nowrap\">\r\n                        {{ item.get(\"uom\") or item.get(\"stock_uom\") or \"\" }}\r\n                    </td>\r\n\r\n                    <td class=\"po-text-center po-nowrap\">\r\n                        {{ item.get_formatted(\"qty\") if item.get(\"qty\") is not none else \"\" }}\r\n                    </td>\r\n\r\n                    <td class=\"po-text-right po-nowrap\">\r\n                        {{ po_money(item_rate) }}\r\n                    </td>\r\n\r\n                    <td class=\"po-text-right po-nowrap\">\r\n                        {{ po_money(item_amount) }}\r\n                    </td>\r\n\r\n                    <td class=\"po-text-center po-nowrap\">\r\n                        {{ gst_percent_data.value }}%\r\n                    </td>\r\n\r\n                    <td class=\"po-text-right po-nowrap\">\r\n                        {{ po_money(gst_amount_data.value) }}\r\n                    </td>\r\n\r\n                    <td class=\"po-text-right po-nowrap\">\r\n                        {{ po_money(row_total) }}\r\n                    </td>\r\n                </tr>\r\n            {% endfor %}\r\n        </tbody>\r\n    </table>\r\n\r\n    <!-- ===================== AMOUNT WORDS AND SUMMARY ===================== -->\r\n    <table class=\"po-bottom-summary-table po-avoid-break\">\r\n        <tr>\r\n            <td class=\"po-words-cell\">\r\n                <div class=\"po-amount-words\">\r\n                    <div class=\"po-amount-words-title\">Amount in Words:</div>\r\n                    {{ doc.get(\"in_words\") or frappe.utils.money_in_words(grand_total, currency) }}\r\n                </div>\r\n            </td>\r\n\r\n            <td class=\"po-summary-cell\">\r\n                <table class=\"po-summary-table\">\r\n                    <tr>\r\n                        <td class=\"po-summary-label\">Total Amount (Before Tax)</td>\r\n                        <td class=\"po-summary-value\">{{ po_money(before_tax_total) }}</td>\r\n                    </tr>\r\n\r\n                    <tr>\r\n                        <td class=\"po-summary-label\">Total GST Amount</td>\r\n                        <td class=\"po-summary-value\">{{ po_money(total_taxes if total_taxes else data.total_item_gst) }}</td>\r\n                    </tr>\r\n\r\n                    <tr class=\"po-summary-final\">\r\n                        <td class=\"po-summary-label\">Grand Total ({{ currency }})</td>\r\n                        <td class=\"po-summary-value\">{{ po_money(grand_total) }}</td>\r\n                    </tr>\r\n                </table>\r\n            </td>\r\n        </tr>\r\n    </table>\r\n\r\n    <!-- ===================== TERMS AND CONDITIONS ===================== -->\r\n    <div class=\"po-terms-section\">\r\n        <div class=\"po-terms-title\">\r\n            Terms &amp; Conditions:\r\n        </div>\r\n\r\n        <div class=\"po-terms-content\">\r\n            {{ terms_data.content | safe }}\r\n        </div>\r\n    </div>\r\n\r\n    <!-- ===================== SIGNATURE ===================== -->\r\n    <div class=\"po-signature-section\">\r\n        {% if doc.get(\"custom_authorized_signature\") %}\r\n        <div class=\"po-signature-space\">\r\n            <img src=\"{{ doc.get(\"custom_authorized_signature\") }}\" style=\"max-height: 70px; max-width: 180px; object-fit: contain;\" />\r\n        </div>\r\n        {% else %}\r\n        <div class=\"po-signature-space\"></div>\r\n        {% endif %}\r\n        <div class=\"po-sign-line\">\r\n            Authorized Signature\r\n        </div>\r\n    </div>\r\n\r\n</div>",
