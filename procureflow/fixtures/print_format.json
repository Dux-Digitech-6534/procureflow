  "html": "<style>\n\n@page {\n    size:A4;\n    margin:12mm;\n}\n\nbody{\n    font-family: Arial, Helvetica, sans-serif;\n    font-size:10px;\n    color:#000;\n}\n\n.top{\n    width:100%;\n}\n.top td{\n    padding:3px;\n    vertical-align:top;\n    font-size:11px;\n}\n\n.items{\n    width:100%;\n    border-collapse:collapse;\n    margin-top:8px;\n}\n\n.items th,\n.items td{\n    border:1px solid #000;\n    padding:5px;\n    font-size:10px;\n}\n\n.items th{\n    font-weight:700;\n    text-align:center;\n    background:#eaeaea;\n    font-size:11px;\n    color:#000 !important;\n}\n\n.items td:nth-child(1){\n    text-align:center;\n}\n\n.items td:nth-child(4),\n.items td:nth-child(5),\n.items td:nth-child(6),\n.items td:nth-child(7),\n.items td:nth-child(8){\n    text-align:center;\n}\n\n.items td:nth-child(9),\n.items td:nth-child(10){\n    text-align:right;\n}\n\n.desc{\n    vertical-align:top;\n    line-height:1.4;\n}\n\n.total-row td{\n    font-weight:700;\n}\n\n.sign{\n    text-align:right;\n    margin-top:35px;\n    font-weight:700;\n}\n\n.terms{\n    margin-top:15px;\n    font-size:10px;\n}\n\n</style>\n\n{% set company = frappe.get_doc(\"Company\", doc.company) %}\n{% set addr = frappe.get_doc(\"Address\", company.company_address) if company.company_address else None %}\n\n<div style=\"text-align:center; font-size:15px; font-weight:700;\">\n    {{ doc.company }}\n</div>\n\n<div style=\"border-top:2px solid #000; margin:10px 0;\"></div>\n\n<div style=\"text-align:center; font-size:18px; font-weight:700;\">\n    PURCHASE ORDER\n</div>\n\n<table class=\"top\">\n<tr>\n<td width=\"60%\">\nSupplier : <b>{{ doc.supplier }}</b><br>\nAddress : {{ doc.address_display or \"\" }}\n</td>\n\n<td width=\"40%\">\nPO Number : {{ doc.name }}<br>\nPO Date : {{ frappe.utils.formatdate(doc.transaction_date,\"dd-MM-yyyy\") }}<br>\nLocation : {{ addr.city if addr else \"\" }}<br>\nCost Centre : {{ doc.cost_center or \"\" }}\n</td>\n</tr>\n</table>\n\n<br><br>\n\n<table class=\"items\">\n\n<tr>\n<th width=\"5%\">Sl</th>\n<th width=\"25%\">Description</th>\n<th width=\"10%\">Due Date</th>\n<th width=\"8%\">Qty</th>\n<th width=\"6%\">UOM</th>\n\n<th width=\"10%\">Rate Without Tax</th>\n<th width=\"8%\">Tax %</th>\n<th width=\"10%\">Tax Amount</th>\n\n<th width=\"8%\">Rate With Tax</th>\n<th width=\"10%\">Amount</th>\n</tr>\n\n{% for item in doc.items %}\n<tr>\n\n<td>{{ loop.index }}</td>\n\n<td class=\"desc\">\n<b>{{ item.get(\"item_code\") }}</b><br>\nSpecification : {{ item.get(\"custom_specification\") or \"\" }}\n</td>\n\n<td>\n{{ frappe.utils.formatdate(item.schedule_date,\"dd-MM-yyyy\") if item.schedule_date else \"\" }}\n</td>\n\n<td>\n{{ item.qty }}\n</td>\n\n<td>\n{{ item.uom }}\n</td>\n\n<td>\n{{ frappe.utils.fmt_money(item.custom_rate_without_tax or 0, currency=doc.currency) }}\n</td>\n\n<td>\n{{ item.custom_tax_percent or 0 }}\n</td>\n\n<td>\n{{ frappe.utils.fmt_money(item.custom_tax_amount or 0, currency=doc.currency) }}\n</td>\n\n<td>\n{{ frappe.utils.fmt_money(item.rate, currency=doc.currency) }}\n</td>\n\n<td>\n<b>{{ frappe.utils.fmt_money(item.amount, currency=doc.currency) }}</b>\n</td>\n\n</tr>\n{% endfor %}\n\n<!-- ✅ FIXED TOTAL ROW -->\n<tr class=\"total-row\">\n\n    <td colspan=\"9\" style=\"text-align:right;\">\n        <b>Total</b>\n    </td>\n\n    <td style=\"text-align:right;\">\n        <b>{{ frappe.utils.fmt_money(doc.total, currency=doc.currency) }}</b>\n    </td>\n\n</tr>\n\n</table>\n\n<br>\n\n<table class=\"items\">\n<tr>\n    <th width=\"70%\">Account Head</th>\n    <th width=\"30%\">Amount</th>\n</tr>\n\n{% for tax in doc.taxes %}\n<tr>\n    <td>{{ tax.account_head }}</td>\n    <td style=\"text-align:right;\">\n        {{ frappe.utils.fmt_money(tax.tax_amount, currency=doc.currency) }}\n    </td>\n</tr>\n{% endfor %}\n\n{% set ns = namespace(total_tax=0) %}\n{% for item in doc.items %}\n    {% set ns.total_tax = ns.total_tax + (item.custom_total_tax_amount or 0) %}\n{% endfor %}\n\n<tr class=\"total-row\">\n    <td>Total Tax Amount</td>\n    <td style=\"text-align:right;\">\n        {{ frappe.utils.fmt_money(ns.total_tax, currency=doc.currency) }}\n    </td>\n</tr>\n\n<tr class=\"total-row\">\n    <td>Grand Total</td>\n    <td style=\"text-align:right;\">\n        {{ frappe.utils.fmt_money(doc.grand_total, currency=doc.currency) }}\n    </td>\n</tr>\n\n<tr>\n    <td colspan=\"2\" style=\"text-align:left;\">\n        <b>Total in Words :</b> {{ doc.in_words }}\n    </td>\n</tr>\n\n</table>\n\n<div class=\"sign\">\nFor {{ company.company_name }}\n\n{% if doc.docstatus == 1 %}\n<p>\n    Approved Digitally On: {{ frappe.utils.formatdate(doc.modified) }}\n</p>\n{% endif %}\n\n<br><br>\n\nAuthorised Signatory\n</div>\n\n<div class=\"terms\">\n<b>Terms & Conditions</b><br>\n{{ doc.terms or \"\" }}\n</div>",
