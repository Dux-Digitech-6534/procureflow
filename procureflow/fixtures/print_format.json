  "html": "<style>\n\n@page {\n    size:A4;\n    margin:12mm;\n}\n\nbody{\n    font-family: Arial, Helvetica, sans-serif;\n    font-size:10px;\n    color:#000;\n}\n\n/* TOP INFO */\n.top{\n    width:100%;\n}\n.top td{\n    padding:3px;\n    vertical-align:top;\n    font-size:11px;\n}\n\n/* ITEMS TABLE */\n.items{\n    width:100%;\n    border-collapse:collapse;\n    margin-top:8px;\n}\n\n.items th,\n.items td{\n    border:1px solid #000;\n    padding:5px;\n    font-size:10px;\n}\n\n/* ✅ HEADER STYLE (LIKE YOUR IMAGE) */\n.items th{\n    font-weight:700;\n    text-align:center;\n    background:#eaeaea;\n    font-size:11px;\n    color:#000 !important;   /* ✅ FORCE BLACK TEXT */\n}\n}\n\n/* ✅ ALIGNMENTS */\n.items td:nth-child(1),\n.items th:nth-child(1){\n    text-align:center;\n}\n\n.items td:nth-child(3),\n.items td:nth-child(4),\n.items td:nth-child(6),\n.items th:nth-child(3),\n.items th:nth-child(4),\n.items th:nth-child(6){\n    text-align:center;\n}\n\n.items td:nth-child(5),\n.items td:nth-child(7),\n.items th:nth-child(5),\n.items th:nth-child(7){\n    text-align:right;\n}\n\n.items tr{\n    page-break-inside:avoid;\n}\n\n.desc{\n    vertical-align:top;\n    line-height:1.4;\n}\n\n.total-row td{\n    font-weight:700;\n}\n\n/* SIGN */\n.sign{\n    text-align:right;\n    margin-top:35px;\n    font-weight:700;\n}\n\n/* TERMS */\n.terms{\n    margin-top:15px;\n    font-size:10px;\n}\n\n</style>\n\n{% set company = frappe.get_doc(\"Company\", doc.company) %}\n{% set addr = frappe.get_doc(\"Address\", company.company_address) if company.company_address else None %}\n\n<!-- HEADER -->\n\n\n<div style=\"position:relative; width:100%; margin-bottom:10px; min-height:60px;\">\n\n    <!-- LOGO LEFT -->\n    <div style=\"position:absolute; left:0; top:10px;\">\n        \n        {% set file = frappe.get_all(\"File\",\n            filters={\"attached_to_doctype\": \"Company\", \"attached_to_name\": doc.company},\n            fields=[\"file_url\"],\n            limit=1\n        ) %}\n\n        {% if file %}\n            <img src=\"{{ frappe.utils.get_url(file[0].file_url) }}\"\n                 style=\"max-height:60px; width:auto;\">\n        {% endif %}\n\n    </div>\n\n    <!-- CENTER TEXT -->\n    <div style=\"text-align:center; padding-top:10px;\">\n        <div style=\"text-align:center; padding-top:10px;\">\n\n    <!-- COMPANY NAME PEHLE -->\n    <div style=\"font-size:15px; font-weight:700;\">\n        {{ doc.get(\"company\") }}\n    </div>\n\n    \n</div>\n    </div>\n\n</div>\n\n\n\n<!--<div style=\"position:relative; width:100%; margin-bottom:10px;\">-->\n\n    <!-- LOGO LEFT -->\n<!--    <div style=\"position:absolute; left:0; top:0;\">-->\n        \n        \n        \n        <!--<img src=\"{{ frappe.utils.get_url() }}/files/ghru-nagpur.png.crdownload\"-->\n        <!--     style=\"max-width:120px;\">-->\n<!--    </div>-->\n\n    <!-- CENTER TEXT -->\n<!--    <div style=\"text-align:center;\">-->\n<!--        <div style=\"font-size:18px; font-weight:700;\">-->\n<!--            PURCHASE ORDER-->\n<!--        </div>-->\n\n<!--        <div style=\"font-size:15px; font-weight:700;\">-->\n<!--            {{ doc.get(\"company\") }}, Nagpur-->\n<!--        </div>-->\n<!--    </div>-->\n\n<!--</div>-->\n\n<div style=\"border-top:2px solid #000; margin:10px 0;\"></div>\n\n<!-- ✅ YAHAN ADD KARO -->\n<div style=\"text-align:center; font-size:18px; font-weight:700; margin-top:5px;\">\n    PURCHASE ORDER\n</div>\n\n<!-- TOP DETAILS -->\n\n<table class=\"top\">\n<tr>\n\n<td width=\"60%\">\nSupplier : <b>{{ doc.get(\"supplier\") }}</b><br>\nAddress : {{ doc.get(\"address_display\") or \"\" }}\n</td>\n\n<td width=\"40%\">\nFin. Year : {{ frappe.utils.formatdate(doc.get(\"transaction_date\"),\"yyyy\") if doc.get(\"transaction_date\") else \"\" }}<br>\nPO Number : {{ doc.get(\"name\") }}<br>\nPO Date : {{ frappe.utils.formatdate(doc.get(\"transaction_date\"),\"dd-MM-yyyy\") if doc.get(\"transaction_date\") else \"\" }}<br>\nLocation : {{ addr.city if addr else \"\" }}<br>\nCost Centre : {{ doc.get(\"cost_center\") or \"\" }}\n</td>\n\n</tr>\n</table>\n\n<br>\n\n\n\n<b>Subject :</b>\n\n{% if doc.custom_direct_po == 1 %}\n\nDirect Purchase Order : {{ doc.get(\"custom_po_remark_\") or \"\" }}\n\n{% else %}\n\nPurchase Order Against Indent :\n{{ doc.get(\"custom_material_request_id\") or \"\" }}\n\n{% endif %}\n\n\n<!--<b>Subject :</b>-->\n<!--Purchase Order Against Indent :-->\n<!--{{ doc.get(\"custom_material_request_id\") or \"\" }}-->\n\n<br><br>\n\nWith reference to your quotation No. {{ doc.get(\"custom_quotation_number\") or \"\" }}\n\n<br>\nWe are pleased to place order for following:\n\n<!-- ITEMS TABLE -->\n\n<table class=\"items\">\n\n<tr>\n<th width=\"5%\">Sl No</th>\n<th width=\"45%\">Description</th>\n<th width=\"10%\">Due</th>\n<th width=\"10%\">Qty</th>\n<th width=\"10%\">Rate</th>\n<th width=\"5%\">Per</th>\n<th width=\"15%\">Amount</th>\n</tr>\n\n{% for item in doc.get(\"items\", []) %}\n<tr>\n\n<td>{{ loop.index }}</td>\n\n<td class=\"desc\">\n<b>{{ item.get(\"item_code\") }}</b><br>\nSpecification : {{ item.get(\"custom_specification\") or \"\" }}\n</td>\n\n<td>\n{{ frappe.utils.formatdate(item.get(\"schedule_date\"),\"dd-MM-yyyy\") if item.get(\"schedule_date\") else \"\" }}\n</td>\n\n<td>\n<b>{{ item.get(\"qty\") }}</b> {{ item.get(\"uom\") }}\n</td>\n\n<td>\n{{ frappe.utils.fmt_money(item.get(\"rate\"), currency=doc.get(\"currency\")) }}\n</td>\n\n<td>\n{{ item.get(\"uom\") }}\n</td>\n\n<td>\n<b>{{ frappe.utils.fmt_money(item.get(\"amount\"), currency=doc.get(\"currency\")) }}</b>\n</td>\n\n</tr>\n{% endfor %}\n\n<tr class=\"total-row\">\n<td colspan=\"5\">\nIn Words : {{ doc.get(\"in_words\") }}\n</td>\n\n<td colspan=\"2\" align=\"right\">\nGross Total :\n{{ frappe.utils.fmt_money(doc.get(\"grand_total\"), currency=doc.get(\"currency\")) }}\n</td>\n</tr>\n\n</table>\n\n<!-- SIGN -->\n\n<div class=\"sign\">\n    For {{ company.company_name }}\n\n    {% if doc.docstatus == 1 %}\n    <p>\n        Approved Digitally On:\n        {{ frappe.utils.formatdate(doc.modified) }}\n    </p>\n    {% endif %}\n\n    <!-- Signature Image -->\n\n    {% if doc.custom_approved_by_signature %}\n        <div style=\"margin-top:10px;\">\n            <img src=\"{{ doc.custom_approved_by_signature }}\"\n                 style=\"height:65px; max-width:150px;\">\n        </div>\n    {% endif %}\n\n    <br>\n\n    <b>Authorised Signatory</b>\n</div>\n\n<!--<div class=\"sign\">-->\n<!--For {{ company.company_name }}-->\n\n<!--{% if doc.docstatus == 1 %}-->\n<!--<p>-->\n<!--    Approved Digitally On: {{ frappe.utils.formatdate(doc.modified) }}-->\n<!--</p>-->\n<!--{% endif %}-->\n\n<!--<br><br>-->\n\n<!--Authorised Signatory-->\n<!--</div>-->\n\n<!-- TERMS -->\n\n<div class=\"terms\">\n<b>Terms & Conditions</b><br>\n{{ doc.get(\"terms\") or \"\" }}<br><br>\n</div>",
